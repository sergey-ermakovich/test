<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain dark no-action-bar shell; Compose paints the actual UI on top.
         Window background matches the Compose background so there is no light flash. -->
    <style name="Theme.Journal" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
